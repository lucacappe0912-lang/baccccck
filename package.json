{
  "name": "backrooms-hub",
  "version": "1.0.0",
  "private": true,
  "description": "Hub gestionale interno di Backrooms Studio",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "NODE_OPTIONS='--disable-warning=ExperimentalWarning' next dev",
    "build": "next build",
    "start": "NODE_OPTIONS='--disable-warning=ExperimentalWarning' next start",
    "hash-password": "node scripts/hash-password.mjs",
    "seed": "node --experimental-strip-types --no-warnings scripts/seed-demo.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "jose": "^6.2.12",
    "next": "^15.5.27",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "three": "^0.186.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "typescript": "^5.9.3"
  }
}
