# ─── Accesso ────────────────────────────────────────────────────────────────
# Password: una per socio (PASSWORD_HASH_<NOME>) oppure una condivisa (MASTER_PASSWORD_HASH).
# Si generano con l'installer, o con:  npm run hash-password -- "la-password"
PASSWORD_HASH_PLUGGHE=
PASSWORD_HASH_FREYA=
PASSWORD_HASH_ASTRAL=
MASTER_PASSWORD_HASH=
# Segreto per firmare la sessione (minimo 32 caratteri casuali): openssl rand -base64 48
SESSION_SECRET=
# I tre soci (mostrati al login e usati come autori di note/movimenti)
PARTNERS=Plugghe,Freya,Astral
# URL pubblico dell'hub (serve per il redirect del collegamento bancario)
APP_URL=http://localhost:3000

# ─── Automazioni ────────────────────────────────────────────────────────────
# Token per chiamare /api/cron/daily da uno scheduler esterno (Authorization: Bearer ...)
CRON_SECRET=
# true = l'hub esegue da solo la sincronizzazione giornaliera (server sempre acceso)
INTERNAL_SCHEDULER=true
# Ora (0-23, ora del server) della sincronizzazione giornaliera
SYNC_HOUR=6
# Segreto condiviso con il sito: il form candidature invia l'header x-webhook-secret
APPLICATION_WEBHOOK_SECRET=

# ─── Banca (GoCardless Bank Account Data / PSD2) ───────────────────────────
GOCARDLESS_SECRET_ID=
GOCARDLESS_SECRET_KEY=
# Codice ISO paese per l'elenco banche
BANK_COUNTRY=IT

# ─── Google (service account: Drive + Analytics GA4) ───────────────────────
# Email e chiave privata del service account (condividi con lui la cartella Drive e la proprietà GA4)
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
# ID della cartella Drive che contiene i fogli/CSV dei clienti
GOOGLE_DRIVE_FOLDER_ID=
# ID numerico della proprietà GA4 del sito
GA4_PROPERTY_ID=

# ─── Instagram (account Professionale: Business o Creator) ─────────────────
# Token "Instagram Login" (inizia con IG...): l'hub lo rinnova da solo ogni 20 giorni.
INSTAGRAM_ACCESS_TOKEN=
# Necessario solo se usi un token del login Facebook (inizia con EAA...)
INSTAGRAM_USER_ID=

# ─── TikTok (Display API v2) ───────────────────────────────────────────────
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Facoltativo: di solito si collega l'account dal pulsante in Integrazioni
TIKTOK_REFRESH_TOKEN=
